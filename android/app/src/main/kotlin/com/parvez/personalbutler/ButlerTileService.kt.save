

package com.parvez.personalbutler

import android.service.quicksettings.Tile
import android.service.quicksettings.TileService

class ButlerTileService : TileService() {

    private val preferences by lazy {
        getSharedPreferences("personal_butler", MODE_PRIVATE)
    }

    override fun onStartListening() {
        super.onStartListening()
        updateTile()
    }

    override fun onClick() {
        super.onClick()

        val enabled = preferences.getBoolean("enabled", false)
        preferences.edit()
            .putBoolean("enabled", !enabled)
            .apply()

        updateTile()
    }

    private fun updateTile() {
        val enabled = preferences.getBoolean("enabled", false)
        qsTile?.let { tile ->
            tile.label = "Personal Butler"
            tile.subtitle = if (enabled) "On" else "Off"
            tile.state = if (enabled) Tile.STATE_ACTIVE else Tile.STATE_INACTIVE
            tile.updateTile()
        }
    }
}
